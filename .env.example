NODE_ENV=development
DATABASE_URL=postgres://schemora:schemora_local@127.0.0.1:55432/schemora
TEST_DATABASE_URL=postgres://schemora:schemora_local@127.0.0.1:55432/schemora_test
API_PORT=4001
API_HOST=127.0.0.1
API_ORIGIN=http://127.0.0.1:4001
WEB_ORIGIN=http://localhost:3010
# Development identity is explicitly local-only. Production requires GitHub OAuth.
DEV_AUTH=true
SESSION_SECRET=local-development-only-change-before-deploy-64-characters-minimum
AUTH_SECRET=local-auth-only-change-before-deploy-64-characters-minimum
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
STORAGE_DRIVER=filesystem
STORAGE_DIRECTORY=.schemora/objects
EXTRACTION_MODE=rules
# Remote photo recognition remains disabled unless separately reviewed and enabled in both API and worker.
VISION_RECOGNITION_ENABLED=false
VISION_RECOGNITION_APPROVED=false
VISION_RECOGNITION_NOTICE_REVISION=vultr-qwen3.8-27b-notice-v1
VISION_RECOGNITION_MODE=disabled
VISION_PROVIDER_ENDPOINT=https://api.vultrinference.com/v1/chat/completions
# Set the rotated secret only in the private worker environment; never commit it.
# VISION_PROVIDER_API_KEY=
VISION_PROVIDER_MODEL=qwen3.8-27b
WORKER_VISION_CONCURRENCY=1
# Opt-in remote extraction requires configured provider and documented user-data policy.
# Leave provider settings absent until a provider is selected and its data policy reviewed.
# EXTRACTION_ENDPOINT=https://approved-provider.example/v1/chat/completions
# EXTRACTION_API_KEY=your-private-server-key
# EXTRACTION_MODEL=approved-model-name
PROVIDER_REVIEW_APPROVED=false
WORKER_PROCESS_CONCURRENCY=2
WORKER_DELETE_CONCURRENCY=1
WORKER_FIRMWARE_COMPILER_PROFILES_JSON=[]
WORKER_FIRMWARE_BUILD_ATTESTATION_PUBLIC_KEYS_JSON={}
DATABASE_POOL_SIZE=10
# Source bytes are bounded to 10 MiB; archive-expanded bytes have an independent parser limit.
